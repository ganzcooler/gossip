# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=gossip
DB_USER=gossip_user
DB_PASSWORD=secure_password

# Optional: full SQLAlchemy URL (overrides the DB_* values above)
# DATABASE_URL=postgresql+asyncpg://gossip_user:secure_password@postgres:5432/gossip

# Optional: PostgreSQL database for integration tests; unset skips them
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:55432/gossip_test

# Host directory for generated images and logs (used by docker-compose.yaml)
# Set this to the host path that should persist the generated files.
GOSSIP_DATA_DIR=./data

# Output directories inside the container
ARTICLES_DIR=/app/articles
LOGS_DIR=/app/logs

# API keys
OPENROUTER_API_KEY=your_openrouter_api_key

# OpenRouter models (optional overrides)
# OPENROUTER_TEXT_MODEL=deepseek/deepseek-v4.1-flash-1017
# OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-5-0-flash
# OPENROUTER_DECISION_MODEL=typesafe/jev-1.14
# OPENROUTER_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
# IMAGE_ARTIFACT_BORDER_OR_FRAME_THRESHOLD=0.5
# IMAGE_ARTIFACT_BLANK_BAND_OR_STRIP_THRESHOLD=0.5
# IMAGE_ARTIFACT_FLAT_BLANK_BLOCK_THRESHOLD=0.5
# IMAGE_ARTIFACT_MULTI_PANEL_OR_SEAM_THRESHOLD=0.5
# IMAGE_ARTIFACT_UNINTENDED_TEXT_OR_WATERMARK_THRESHOLD=0.4
# IMAGE_ARTIFACT_GENERATION_GLITCH_THRESHOLD=0.6
# OPENROUTER_REASONING_EFFORT=max

# SessionNet
SESSIONNET_BASE_URL=https://sessionnet.owl-it.de/rosdorf/BI/

# Public hostname used by the deployment
TRAEFIK_HOST=gossip.example.com

# Logging
LOG_LEVEL=INFO
