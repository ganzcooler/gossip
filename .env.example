# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=gossip
DB_USER=gossip_user
DB_PASSWORD=secure_password

# Optional: full SQLAlchemy URL (overrides the DB_* values above)
# DATABASE_URL=postgresql+asyncpg://gossip_user:secure_password@postgres:5432/gossip

# Host directory for article and log output (used by docker-compose.yaml)
# Set this to the host path that should persist the generated files.
GOSSIP_DATA_DIR=./data

# Output directories inside the container
ARTICLES_DIR=/app/articles
LOGS_DIR=/app/logs

# API keys
OPENROUTER_API_KEY=your_openrouter_api_key

# OpenRouter models (optional overrides)
# OPENROUTER_TEXT_MODEL=deepseek/deepseek-v4.1-flash-1017
# OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
# OPENROUTER_REASONING_EFFORT=max

# SessionNet
SESSIONNET_BASE_URL=https://sessionnet.owl-it.de/rosdorf/BI/

# Public hostname used by the deployment
TRAEFIK_HOST=gossip.example.com

# Logging
LOG_LEVEL=INFO
