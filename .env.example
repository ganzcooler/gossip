# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=gossip
DB_USER=gossip_user
DB_PASSWORD=secure_password

# Optional: full SQLAlchemy URL (overrides the DB_* values above)
# DATABASE_URL=postgresql+asyncpg://gossip_user:secure_password@postgres:5432/gossip

# Output directories (container paths by default)
ARTICLES_DIR=/app/articles
LOGS_DIR=/app/logs

# API keys
GOOGLE_API_KEY=your_google_api_key

# SessionNet
SESSIONNET_BASE_URL=https://sessionnet.owl-it.de/rosdorf/BI/

# Public hostname used by the deployment
TRAEFIK_HOST=gossip.example.com

# Logging
LOG_LEVEL=INFO
